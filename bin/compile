#!/usr/bin/env bash
# usage: bin/compile <build_dir> <cache_dir> <env_dir>


cmnlib="$( readlink -f "$( dirname "${0}" )/../vendor/cmnlib.sh" )"
# shellcheck source=vendor/cmnlib.sh
source "${cmnlib}"

cmn::main::start "${0}" "${1}" "${2}" "${3}"

# -----------------------------------------------------------------------------

# Inventory file:
inventory="${buildpack_dir:?}/INVENTORY.tsv"

# This statement won't fail even if cmn::inventory::get_default were to fail.
version="${KIBANA_VERSION:-$( cmn::inventory::get_default "${inventory}" )}"

if [[ -z "${version}" ]]; then
	cmn::main::fail 1 <<- EOM
		Unable to determine which version of Kibana to deploy.
		It seems like there's no default version in the inventory file either,
		which isn't OK.

		Please:
		1. Set KIBANA_VERSION environment variable to the desired value, and
		   try to redeploy. It should pass.
		2. Either reach out to our Support Team to let them know about this
		   situation, or file an issue in the kibana-buildpack repository
		   (https://github.com/Scalingo/kibana-buildpack/issues).
		Thanks <3

		Aborting for now.
	EOM
fi

if ! archive_url="$( cmn::inventory::get_url "${inventory}" "${version}" )"
then
	cmn::main::fail 1 <<- EOM
		Unable to retrieve download URL for version ${version}".
		It seems like there's an issue with the buildpack inventory file.

		Please either reach out to our Support Team to let them know about this
		situation, or file an issue in the kibana-buildpack repository
		(https://github.com/Scalingo/kibana-buildpack/issues)
		Thanks <3

		Aborting for now.
	EOM
fi

if ! archive_checksum="$( cmn::inventory::get_checksum "${inventory}" "${version}" )"
then
	cmn::main::fail 1 <<- EOM
		Unable to retrieve checksum for version ${version}".
		It seems like there's an issue with the buildpack inventory file.

		Please either reach out to our Support Team to let them know about this
		situation, or file an issue in the kibana-buildpack repository
		(https://github.com/Scalingo/kibana-buildpack/issues)
		Thanks <3

		Aborting for now.
	EOM
fi

cache_file="${cache_dir:?}/kibana-${version}.tar.gz"
kibana_dir="${build_dir:?}/kibana"
kibana_config_file="${kibana_dir}/config/kibana.yml"
build_log="${tmp_dir:?}/build.log"

cmn::output::info "Deploying Kibana ${version}"

# -----------------------------------------------------------------------------

cmn::step::start "Installing Kibana"

if [[ ! -f "${cache_file}" ]]; then
	# The archive doesn't exist in the cache.

	# Remove any existing cached archive, as they are probably for another
	# version:
	cmn::task::start "Cleaning cache"
	rm --recursive --force "${cache_dir:?}"/kibana*.tar.gz
	cmn::task::finish

	# Download appropriate version:
	cmn::task::start "Downloading archive"
	if ! cmn::file::download "${archive_url}" "${cache_file}"; then
		cmn::main::fail 2 <<-EOM
			Unable to download Kibana archive.
			Aborting.
		EOM
	fi
	cmn::task::finish
else
	# The archive is in cache.

	cmn::output::info "Found matching file in cache."
fi

# From this point, we have an archive in cache.

# We always check the archive validity to prevent cache corruption and other
# issues.
cmn::task::start "Checking archive validity"
if ! cmn::file::validate_checksum "${cache_file}" "${archive_checksum}"; then
	# File in cache does not seem valid,
	# remove it so a future run can be successful
	rm --force -- "${cache_file}"

	cmn::main::fail 2 <<-EOM
		The checksum for the archive file in the cache doesn't match what's
		expected.

		Here are the most common causes:

		- A networking issue occurred, causing the downloaded checksum file to
		  be incomplete or corrupt. Triggering a new deployment should force
		  the platform to download the archive and the checksum again, and the
		  deployment should pass.

		- Upstream replaced the archive and its checksum, resulting in the
		  same version number having a different checksum. This could mean a
		  malicious threat tampered the source archive and its checksum.
		  Please check upstream for a potential explanation and make sure it's
		  still trustable.

		In all cases, the cached archive has been removed to force a new
		download during the next deployment attempt.

		Aborting.
	EOM
fi
cmn::task::finish

# From this point we have a valid file in cache.

cmn::task::start "Extracting"
mkdir --parents "${kibana_dir}"
tar --extract --file="${cache_file}" --directory="${kibana_dir}" \
	--strip-components=1
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Configuring"

cmn::task::start "Setting up configuration file"
# Environment variable can be injected into Kibana's config file using
# the regular ${MY_ENV_VAR} syntax.
# Default value can be provided using ${MY_ENV_VAR:default_value}.

if [[ -f "${build_dir:?}/kibana.yml" ]]; then
	# Use the user-provided file, if any:
	cp -- "${build_dir:?}/kibana.yml" "${kibana_config_file}" \
		2>/dev/null
else
	# Use the default one:
	cp -- "${buildpack_dir:?}/vendor/kibana.yml" "${kibana_config_file}" \
		2>/dev/null
fi
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Building Environment"

mkdir --parents "${build_dir:?}/.profile.d"

cmn::task::start "Setting up environment"
cp -- "${buildpack_dir:?}/vendor/profile.d/060-kibana.sh" \
	"${build_dir:?}/.profile.d/"

PATH="${PATH:+${PATH}:}${kibana_dir}/bin"
export PATH
cmn::task::finish

# -----------------------------------------------------------------------------

cmn::step::start "Installing plugins"

cmn::task::start "Removing plugin x-pack"
if ! kibana-plugin remove "x-pack" > "${build_log}" 2>&1; then
	cmn::task::fail
	cmn::output::err < "${build_log}"
	cmn::main::fail 10 <<-EOM
		Unable to remove x-pack plugin.
		Aborting.
	EOM
fi
cmn::task::finish

if [[ -f "${build_dir:?}/kibana-plugins" ]]; then
	cmn::output::info "Detected kibana-plugins file"

	while IFS= read -r plugin; do
		cmn::task::start "Installing plugin ${plugin}"
		if ! kibana-plugin install "${plugin}" > "${build_log}" 2>&1; then
			cmn::task::fail
			cmn::output::err < "${build_log}"
			cmn::main::fail 11 <<-EOM
				Unable to install plugin ${plugin}.
				Aborting.
			EOM
		fi
		cmn::task::finish
	done < "${build_dir:?}/kibana-plugins"
fi

if [[ -f "${build_dir:?}/kibana-plugins.yml" ]]; then
	cmn::output::info "Detected kibana-plugins.yml file"
	cmn::task::start "Appending plugins configuration"

	printf '\n' >> "${kibana_config_file}"
	cat -- "${build_dir:?}/kibana-plugins.yml" >> "${kibana_config_file}"
fi

# -----------------------------------------------------------------------------

cmn::main::finish
